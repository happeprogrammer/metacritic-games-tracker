# Copy to .env and fill in. Never commit .env.

# --- public address (used by Traefik labels in compose.yaml) ---
APP_HOST=games.example.com
# Docker network of your reverse proxy (Traefik) and its certificate resolver name
PROXY_NETWORK=proxy
CERT_RESOLVER=letsencrypt

# --- sign-in: two roles; hashes come from `node scripts/hash-password.js <password>` ---
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
VIEWER_USER=viewer
VIEWER_PASS_HASH=
ADMIN_USER=admin
ADMIN_PASS_HASH=
# optional read-only account for reviewers: sees every admin screen, cannot change or download anything
OBSERVER_USER=observer
OBSERVER_PASS_HASH=

# --- AI providers (free tiers); any subset works, the chain skips providers without a key ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
# YOUTUBE_API_KEY=            # optional: only for the "api" lets-play search mode

# --- optional ---
# MOCK=1                      # run on recorded fixtures instead of the live site and real AI (tests, demos)
# METACRITIC_API_KEY=         # override the public key embedded in Metacritic's own frontend
# PORT=3000
# TRUST_PROXY=1               # set behind Traefik: client IP and protocol come from X-Forwarded-* headers
